pipeline{

    agent any

    stages{
        stage('build-jar'){
            steps{
            sh "mvn clean package -DskipTests"
        }}

        stage('build-image'){
            steps{
            sh "docker build -t=husainrehan/selenium ."
        }}

        stage('push-image-to-dockerhub'){
            steps{
            sh "docker push husainrehan/selenium:latest"
            sh "docker tag husainrehan/selenium:latest husainrehan/selenium:${env.BUILD_NUMBER}"
            sh "docker push husainrehan/selenium:latest husainrehan/selenium:${env.BUILD_NUMBER}"
        }}

    }

    post{
        always{ echo "doing clean up"}
    }

}